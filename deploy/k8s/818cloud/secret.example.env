# Copy to /tmp/fde-secret.env — DO NOT COMMIT
# kubectl -n fde-study create secret generic fde-platform-secrets --from-env-file=/tmp/fde-secret.env

JWT_SECRET=replace-with-long-random-string

# In-cluster CNPG: postgresql://fde:PASS@fde-pg-rw.fde-study.svc:5432/fde
# Or external NodePort (LingZhi pattern): postgresql://fde-user:PASS@39.98.54.21:PORT/fde
DATABASE_URL=postgresql://fde:PASSWORD@YOUR_PG_HOST:5432/fde

# base-service MinIO (same cluster as LingZhi): minio.base-service.svc.cluster.local:9000
# Keys must match MinIO MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
S3_ACCESS_KEY=root
S3_SECRET_KEY=YOUR_MINIO_ROOT_PASSWORD

# WeChat Pay v3 (商户平台)
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=

# PEM files: use --from-file instead of env lines (see README.md)
# WECHAT_PAY_PRIVATE_KEY  → apiclient_key.pem content
# WECHAT_PAY_PLATFORM_CERT → wechatpay_platform.pem content

# AI coach (optional)
DEEPSEEK_API_KEY=

# LingZhi / anyCode (optional)
LINGZHI_API_KEY=
ANYCODE_API_TOKEN=
