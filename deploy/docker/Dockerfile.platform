# All-in-one platform image: React SPA + FastAPI + worker + nginx gateway.
# Build:  docker build -f deploy/docker/Dockerfile.platform -t fde-platform:local .
# Migrate: docker run ... fde-platform:local python -m services.migrations_runner
# Bootstrap: docker run ... fde-platform:local python -c "from services.shared import init_schema; init_schema()"

FROM docker.m.daocloud.io/library/node:20-alpine AS web-build
WORKDIR /app
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM docker.m.daocloud.io/library/python:3.12-slim AS base

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    nginx \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 fde \
    && useradd -u 10001 -g fde -m -s /usr/sbin/nologin fde \
    && rm -f /etc/nginx/sites-enabled/default

COPY requirements-skeleton.txt .
RUN pip install --no-cache-dir -r requirements-skeleton.txt

COPY backend/services ./services
COPY contracts ./contracts
COPY backend/migrations ./migrations
COPY class ./class
COPY scripts ./scripts
COPY sim ./sim
COPY skills ./skills
COPY README.md ./

COPY --from=web-build /app/dist /usr/share/nginx/html
COPY deploy/docker/nginx-platform.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/entrypoint-platform.sh /entrypoint.sh
RUN mkdir -p /data \
    && chmod +x /entrypoint.sh \
    && chown -R fde:fde /app /data \
    && chown -R www-data:www-data /usr/share/nginx/html /var/log/nginx /var/lib/nginx

ENV PYTHONPATH=/app \
    FDE_ENV=prod \
    FDE_API_PORT=8760 \
    FDE_DATA_DIR=/data \
    FDE_WORKSPACE_ROOT=/data/workspaces \
    FDE_ARTIFACT_ROOT=/data/artifacts \
    FDE_TEMP_WORKSPACE_ROOT=/data/tmp_workspaces

VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD curl -sf http://127.0.0.1:8080/livez || exit 1

ENTRYPOINT ["/entrypoint.sh"]
