# FDE Learning OS

FDE_ENV=dev
JWT_SECRET=dev-fde-jwt-secret-change-me

# Required: PostgreSQL only (no SQLite runtime)
DATABASE_URL=postgresql://fde:fde@127.0.0.1:5433/fde

# DeepSeek — AI 任务导师（coach ask/stream）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# LingZhi（课程知识等其它链路；导师对话已不再走知识库）
LINGZHI_BASE_URL=http://127.0.0.1:8230
LINGZHI_API_KEY=
LINGZHI_CLIENT_TOKEN=
LINGZHI_SOURCE_ID=
LINGZHI_CAMP_KEYS=

# anyCode Workbench HTTP (headless AgentRuntime; no Desktop client required)
# AGENT_MODE=auto|live|stub — prod should use live (hard-fail, no silent stub)
ANYCODE_DASHBOARD_URL=http://127.0.0.1:43180
ANYCODE_API_TOKEN=
ANYCODE_COACH_SKILL_ID=fde-coach
ANYCODE_LOCAL_PREP_SKILL_ID=fde-local-prep
ANYCODE_SSE_TIMEOUT_SEC=180
AGENT_MODE=stub

# Data / temp workspace (Agent hydrate target)
FDE_DATA_DIR=./data
FDE_WORKSPACE_ROOT=./data/workspaces
FDE_ARTIFACT_ROOT=./data/artifacts
FDE_TEMP_WORKSPACE_ROOT=./data/tmp_workspaces
FDE_WORKSPACE_MAX_BYTES=52428800
FDE_DOCUMENT_MAX_BYTES=31457280

FDE_API_PORT=8760
FDE_DEV_PORT=5173
FDE_INTERNAL_BASE=http://127.0.0.1:8760
FDE_CORS_ORIGINS=http://127.0.0.1:8760,http://localhost:8760,http://127.0.0.1:5173
FDE_DEFAULT_CAMP_ID=camp-v03
FDE_CURRICULUM_VERSION_TAG=v0.7
FDE_SEED_VERSION_TAGS=v0.7,fde-v07
FDE_DHX_ROOT=../digital-human-platform
FDE_HYPERFRAMES_VERSION=0.7.72
FDE_ALLOW_DEV_HEADERS=0
FDE_SEED_DEMO_USERS=1

# Agnes (landing story videos / posters) — https://platform.agnes-ai.com/
# Requires Token Plan subscription; free keys return 402 subscription_not_found.
AGNES_API_KEY=

FDE_LEARNER_EMAIL=learner@fde.local
FDE_LEARNER_PASSWORD=learner1234
FDE_DEMO_EMAIL=demo@fde.local
FDE_DEMO_PASSWORD=demo1234
FDE_AUTHOR_EMAIL=author@fde.local
FDE_AUTHOR_PASSWORD=author1234
FDE_FINANCE_EMAIL=finance@fde.local
FDE_FINANCE_PASSWORD=finance1234
FDE_ADMIN_EMAIL=admin@fde.local
FDE_ADMIN_PASSWORD=admin1234

# MinIO (required for documents/workspaces/artifacts)
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=fdeadmin
S3_SECRET_KEY=fdeadmin123
S3_BUCKET_DOCUMENTS=fde-documents
S3_BUCKET_WORKSPACES=fde-workspaces
S3_BUCKET_ARTIFACTS=fde-artifacts
S3_BUCKET_BACKUPS=fde-backups
S3_FORCE_PATH_STYLE=1

# Optional malware scan
CLAMAV_ENABLED=0

# SQL Lab sandbox (M4) — defaults to DATABASE_URL host with db swapped to
# fde_sandbox; only set SANDBOX_DATABASE_URL to point at a different server.
# SANDBOX_DATABASE_URL=postgresql://fde:fde@127.0.0.1:5433/fde_sandbox
SQL_LAB_SESSION_TTL_SEC=14400
SQL_LAB_STATEMENT_TIMEOUT_MS=10000

JWT_TTL_SEC=900
REFRESH_TTL_SEC=604800

# KYC adapter (M6) — services/application/kyc.py
# KYC_PROVIDER=stub|http; KYC_HTTP_URL only used when http.
KYC_PROVIDER=stub
KYC_HTTP_URL=

# Certificates (M6) — allow issuing without a verified identity outside prod.
# Always false when FDE_ENV=prod regardless of this value.
FDE_CERT_ALLOW_UNVERIFIED=1

# Rate limiting (M6) — services/shared/rate_limit.py, "<count>/<unit>".
RATE_LIMIT_LOGIN=20/min
RATE_LIMIT_UPLOAD=30/min
RATE_LIMIT_COACH_ASK=30/min
RATE_LIMIT_SQL_EXEC=60/min

# WeChat Pay v3 (partner billing) — keys must NOT be committed
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
# WECHAT_PAY_PLATFORM_CERT_PATH=/path/to/wechatpay_platform.pem
# FDE_PUBLIC_BASE_URL=https://your-domain.example
# WECHAT_PAY_SKIP_VERIFY=1
# Learner must bind 服务号 before /app. Default: on in prod, off in local/dev.
# FDE_REQUIRE_WX_BIND=0

# Certificates — default local FDE chain (see services/chain/)
# CHAIN_PROVIDER=fde|stub|http
CHAIN_PROVIDER=fde

# Runtime migrate-on-boot guard (see services/shared/__init__.py init_schema).
# Prod ignores this unless explicitly set to 1 — keep 0 outside a one-off bootstrap.
FDE_ALLOW_RUNTIME_MIGRATE=0

# /readyz queue-depth warning threshold (informational only, never fails readiness)
FDE_QUEUE_DEPTH_WARN=100
