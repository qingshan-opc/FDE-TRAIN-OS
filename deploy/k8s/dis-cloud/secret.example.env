# Copy to deploy/k8s/dis-cloud/.env — DO NOT COMMIT
# NS=dis-cloud ./scripts/apply_k8s_secrets_dis_cloud.sh

JWT_SECRET=replace-with-long-random-string

# 集群内 PG 示例: postgresql://fde:PASS@postgres.dis-cloud.svc:5432/fde
# 或外部 NodePort: postgresql://fde-user:PASS@39.98.54.21:PORT/fde
DATABASE_URL=postgresql://fde:PASSWORD@YOUR_PG_HOST:5432/fde

# base-service MinIO（与灵知共用）: minio.base-service.svc.cluster.local:9000
S3_ACCESS_KEY=root
S3_SECRET_KEY=YOUR_MINIO_ROOT_PASSWORD

# AI coach（可选）
DEEPSEEK_API_KEY=

# 微信支付（可选，不填则跳过）
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
# 与 WECHAT_PAY_APP_ID 对应的 AppSecret（机构扫码绑定 PERSONAL_OPENID 分账接收方）
WECHAT_APP_SECRET=
# 公众号「服务器配置」Token / EncodingAESKey（扫码关注登录）
WECHAT_MP_TOKEN=
WECHAT_MP_AES_KEY=

# 支付宝开放平台 RSA2（当面付预下单）
ALIPAY_APP_ID=
# 可选：密钥文件路径（apply 脚本会写入 Secret；也可用下方字面量）
# ALIPAY_PRIVATE_KEY_FILE=deploy/k8s/dis-cloud/secrets/alipay/app_private_key.pem
# ALIPAY_PUBLIC_KEY_FILE=deploy/k8s/dis-cloud/secrets/alipay/alipay_public_key.pem
